---
import { nav, links, person } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-nav">
  <a class="brand" href="/" aria-label={`${person.name}, home`}>
    <svg viewBox="0 0 32 32" aria-hidden="true">
      <circle cx="16" cy="16" r="10.5" fill="none" stroke="var(--blue)" stroke-width="2.5" />
      <rect x="6" y="14.6" width="20" height="2.8" rx="1" fill="var(--blue)" transform="rotate(-18 16 16)" />
      <g stroke="var(--blue)" stroke-width="2.4" stroke-linecap="round">
        <path d="M16 1.5v3M16 27.5v3M1.5 16h3M27.5 16h3" />
      </g>
    </svg>
    <span class="halo">{person.name}</span>
  </a>
  <nav aria-label="Main">
    <ol class="route">
      {nav.map((n) => (
        <li>
          <a href={n.href} aria-current={path === n.href || path.startsWith(n.href + '/') ? 'page' : undefined}>
            <span class="halo">{n.label}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
  <div class="nav-end">
    <a class="btn btn--ghost" href={links.resume}>Résumé (PDF)</a>
  </div>
</header>
