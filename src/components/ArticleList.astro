---
import type { CollectionEntry } from "astro:content";

interface Props {
  articles: CollectionEntry<"articles">[];
  level?: "h2" | "h3";
}

const { articles, level = "h3" } = Astro.props;

const Heading = level;

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---

<ol class="article-list" reversed>
  {articles.map((a) => (
    <li>
      <time datetime={a.data.date.toISOString()}>{fmt(a.data.date)}</time>
      <div>
        <Heading>
          <a href={`/articles/${a.id}`}>{a.data.title}</a>
        </Heading>
        <p>{a.data.description}</p>
      </div>
    </li>
  ))}
</ol>
