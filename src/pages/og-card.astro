---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
const title = Astro.url.searchParams?.get('t') ?? '';
---
<html lang="en"><body style="margin:0;width:1200px;height:630px;overflow:hidden">
<div style="position:relative;width:1200px;height:630px;display:flex;flex-direction:column;justify-content:flex-end;padding:64px 72px;box-sizing:border-box">
  <canvas id="c" style="position:absolute;inset:0;width:1200px;height:630px;z-index:-1"></canvas>
  <p id="kicker" style="font-weight:700;font-stretch:80%;font-size:30px;margin:0 0 18px"><span class="halo">sankalpmukim.dev</span></p>
  <h1 id="t" style="font-weight:900;font-stretch:125%;font-size:112px;line-height:.88;max-width:15ch;margin:0"><span class="halo" style="-webkit-text-stroke-width:.12em">Sankalp Mukim</span></h1>
  <p id="sub" style="font-weight:600;font-size:34px;margin:22px 0 0;max-width:30ch;line-height:1.25"><span class="halo" style="-webkit-text-stroke-width:.3em">Software engineer at IBM Cloud. Airplanes, mountains, AI agents.</span></p>
</div>
<script>
  import { drawTerrain, drawPeaks, fitCanvas, readColors } from '../scripts/terrain';
  const p = new URLSearchParams(location.search);
  if (p.get('t')) {
    (document.querySelector('#t span') as HTMLElement).textContent = p.get('t');
    (document.getElementById('t') as HTMLElement).style.fontSize = '76px';
    (document.getElementById('t') as HTMLElement).style.lineHeight = '1';
    (document.getElementById('t') as HTMLElement).style.fontStretch = '112%';
    (document.querySelector('#sub span') as HTMLElement).textContent = 'An article by Sankalp Mukim';
  }
  const c = document.getElementById('c') as HTMLCanvasElement;
  document.fonts.ready.then(() => {
    const { ctx, w, h } = fitCanvas(c);
    const t = drawTerrain(ctx, w, h, readColors(), { seed: Number(p.get('seed') || 11), valleys: [{ x: 360, y: 470, r: 420 }], maxPeaks: 3, peakNames: [{ name: 'Hampta Pass', elevation: 4270 }, { name: 'Kedarkantha', elevation: 3810 }, { name: 'Roopkund', elevation: 5029 }] });
    drawPeaks(ctx, t.peaks, readColors());
    document.body.dataset.ready = '1';
  });
</script>
</body></html>
