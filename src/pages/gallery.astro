---
import Base from "../layouts/Base.astro";
import ChartBand from "../components/ChartBand.astro";
import { photos } from "../data/site";
---

<Base
  title="Gallery"
  description="Photos by Sankalp Mukim from Himalayan treks, flights, bicycle rides and travel around India."
>
  <ChartBand
    slot="header"
    title="Gallery"
    intro="Treks, trains, bicycles, and a graduation gown. Real frames from the road."
    seed={44}
  />
  <section class="section wrap" data-pelican="drop" data-pelican-says="Take my picture.">
    <div class="gallery">
      {photos.map((p) => (
        <figure class="photo">
          {p.src ? (
            <img src={p.src} alt={p.alt} loading="lazy" decoding="async" />
          ) : (
            <div class={`photo-placeholder${p.tall ? " tall" : ""}`} role="img" aria-label={p.alt}>
              Photo goes here
            </div>
          )}
          <figcaption>
            {p.caption}
            {p.place && <span>{p.place}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
</Base>
