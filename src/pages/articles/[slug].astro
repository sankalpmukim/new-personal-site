---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import ChartBand from "../../components/ChartBand.astro";
import fs from "node:fs";

export async function getStaticPaths() {
  const articles = await getCollection("articles");

  return articles.map((a) => ({ params: { slug: a.id }, props: { article: a } }));
}

const { article } = Astro.props;

const { Content } = await render(article);

const words = article.body?.split(/\s+/).length ?? 0;

const minutes = Math.max(1, Math.round(words / 230));

const ogPath = `/og/${article.id}.png`;

const image = fs.existsSync(`public${ogPath}`) ? ogPath : "/og/default.png";

const url = new URL(`/articles/${article.id}`, Astro.site).href;

const jsonLd = {
  "@type": "BlogPosting",
  "@id": `${url}#article`,
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.date.toISOString(),
  url,
  mainEntityOfPage: url,
  image: new URL(image, Astro.site).href,
  wordCount: words,
  author: { "@id": new URL("/#person", Astro.site).href },
  publisher: { "@id": new URL("/#person", Astro.site).href },
};

const date = article.data.date.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Base
  title={article.data.title}
  description={article.data.description}
  type="article"
  published={article.data.date}
  image={image}
  jsonLd={jsonLd}
>
  <ChartBand slot="header" title={article.data.title} seed={article.id.length * 7} long>
    <p class="article-meta">
      <a href="/articles">
        <span class="halo">All articles</span>
      </a>
      <time datetime={article.data.date.toISOString()}>
        <span class="halo">{date}</span>
      </time>
      <span class="halo">{minutes} min read</span>
    </p>
  </ChartBand>
  <article
    class="section wrap"
    data-pelican="peek"
    data-pelican-says="I read it. Well, I looked at it."
    data-article={article.id}
    data-article-minutes={minutes}
    data-article-words={words}
  >
    <div class="prose">
      <Content />
    </div>
    <div data-article-end aria-hidden="true"></div>
  </article>
</Base>

<script>
  import { secondsSince, track } from "../../scripts/analytics";

  const article = document.querySelector<HTMLElement>("[data-article]");

  const end = document.querySelector("[data-article-end]");

  if (article && end) {
    const opened = performance.now();

    // fires once, when the reader reaches the end of the text
    const io = new IntersectionObserver(([en]) => {
      if (!en.isIntersecting) return;

      io.disconnect();

      const seconds = secondsSince(opened);
      const minutes = Number(article.dataset.articleMinutes) || 1;

      track("article_finished", {
        article: article.dataset.article ?? null,
        word_count: Number(article.dataset.articleWords) || 0,
        estimated_minutes: minutes,
        seconds_on_page: seconds,
        // skimmers who jump straight to the bottom versus people who actually read it
        read_ratio: Math.round((seconds / (minutes * 60)) * 100) / 100,
      });
    });

    io.observe(end);
  }
</script>
