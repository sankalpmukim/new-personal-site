---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ChartBand from '../../components/ChartBand.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((a) => ({ params: { slug: a.id }, props: { article: a } }));
}
const { article } = Astro.props;
const { Content } = await render(article);
const words = article.body?.split(/\s+/).length ?? 0;
const minutes = Math.max(1, Math.round(words / 230));
const date = article.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={article.data.title} description={article.data.description}>
  <ChartBand slot="header" title={article.data.title} seed={article.id.length * 7} long>
    <p class="article-meta"><a href="/articles"><span class="halo">All articles</span></a><time datetime={article.data.date.toISOString()}><span class="halo">{date}</span></time><span class="halo">{minutes} min read</span></p>
  </ChartBand>
  <article class="section wrap" data-pelican="peek" data-pelican-says="I read it. Well, I looked at it.">
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
