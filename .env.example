# PostHog project token (PostHog → Project settings → Project token). Leave it empty to turn analytics off.
PUBLIC_POSTHOG_PROJECT_TOKEN=
# Where the browser sends events. Production on Vercel uses the same-origin proxy path from
# vercel.json (/relay). Use the direct host locally, because vercel.json rewrites do not run
# under `astro dev` or `astro preview`.
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional. The PostHog app URL, used for toolbar and replay links. Defaults to US cloud.
PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
