# PostHog project token (PostHog → Project settings → Project token). Leave it empty to turn analytics off.
PUBLIC_POSTHOG_PROJECT_TOKEN=
# Where the browser sends events. Production uses the same-origin proxy path served by
# worker/index.ts (/relay) on Cloudflare. Use the direct host locally, because the relay
# Worker does not run under `astro dev` or `astro preview` (it does under `wrangler dev`).
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional. The PostHog app URL, used for toolbar and replay links. Defaults to US cloud.
PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
