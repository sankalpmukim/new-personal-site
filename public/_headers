# Cloudflare serves static assets with `public, max-age=0, must-revalidate` by
# default. Astro's /_astro/* files are content-hashed (a new build changes the
# filename), so they are immutable and safe to cache for a year. This restores
# the caching Vercel applied to hashed build output automatically.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
