# Cloudflare serves static assets with `public, max-age=0, must-revalidate` by
# default. Hashed `/_astro/*` files are immutable. Other static media rarely
# changes and can be cached for a long time too. Security headers apply to
# static asset responses only (the PostHog relay sets its own).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=31536000, immutable

/photos/*
  Cache-Control: public, max-age=31536000, immutable

/logos/*
  Cache-Control: public, max-age=31536000, immutable

/articles/*
  Cache-Control: public, max-age=31536000, immutable

/portrait.jpg
  Cache-Control: public, max-age=2592000

/avatar.jpg
  Cache-Control: public, max-age=2592000

/favicon.svg
  Cache-Control: public, max-age=2592000
